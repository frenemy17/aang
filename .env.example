# Provider Configuration
AANG_PROVIDER=groq
AANG_MODEL=openai/gpt-oss-120b

# Groq API Keys (Support single key or comma-separated pool for rotation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2,your_groq_key_3

# OpenRouter Fallback Key (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Anthropic / OpenAI Direct Keys (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Legacy environment variables (supported for backward compatibility)
# ION_PROVIDER=groq
# ION_MODEL=openai/gpt-oss-120b
# ION_API_KEY=your_groq_api_key_here
